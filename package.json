{
  "name": "polysearch",
  "version": "0.4.0",
  "description": "One SearchEngine interface across Elasticsearch, OpenSearch and Solr, with a unified Query DSL and a cross-engine relevance comparison mode.",
  "type": "module",
  "license": "MIT",
  "author": "Alexandro Bolfa",
  "keywords": [
    "search",
    "elasticsearch",
    "opensearch",
    "solr",
    "relevance",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "polysearch": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "RUN_INTEGRATION=1 vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.20",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.1",
    "@opensearch-project/opensearch": "^3.6.0",
    "commander": "^15.0.0"
  }
}
